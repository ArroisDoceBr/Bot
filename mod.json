{
  "geode": "5.11.2",
  "gd": {
    "win": "2.2081",
    "android": "2.2081",
    "mac": "2.2081",
    "ios": "2.2081"
  },
  "version": "v1.4.0",
  "id": "arroisdocebr.decorcopy",
  "name": "Decor Copy",
  "developer": "ArroisDoceBr",
  "description": "Copia o tema e os padroes de decoracao de outra fase.",
  "settings": {
    "level-id": {
      "type": "int",
      "name": "ID da fase (plano B)",
      "default": 0,
      "min": 0
    },
    "theme-only": {
      "type": "bool",
      "name": "Modo so tema (cores e fundo, nao cola nada)",
      "default": true
    },
    "copy-colors": {
      "type": "bool",
      "name": "Copiar cores do tema",
      "default": true
    },
    "copy-bg": {
      "type": "bool",
      "name": "Copiar fundo e chao",
      "default": true
    },
    "pattern-spikes": {
      "type": "bool",
      "name": "Padroes nos espinhos e serras",
      "default": true
    },
    "pattern-blocks": {
      "type": "bool",
      "name": "Padroes nos blocos",
      "default": true
    },
    "templates": {
      "type": "int",
      "name": "Quantos padroes usar por tipo",
      "default": 3,
      "min": 1,
      "max": 10
    },
    "radius": {
      "type": "int",
      "name": "Raio da decoracao",
      "description": "30 = 1 bloco.",
      "default": 45,
      "min": 15,
      "max": 150
    },
    "max-per-object": {
      "type": "int",
      "name": "Max. decoracoes por objeto",
      "default": 40,
      "min": 1,
      "max": 300
    },
    "overlay-zorder": {
      "type": "int",
      "name": "Z-order do visual copiado",
      "description": "Maior = fica por cima do seu objeto.",
      "default": 10,
      "min": -50,
      "max": 50
    },
    "copy-effects": {
      "type": "bool",
      "name": "Copiar efeitos (cor, pulse, fundo)",
      "default": true
    },
    "copy-shake": {
      "type": "bool",
      "name": "Copiar shake",
      "default": false
    },
    "align-portals": {
      "type": "bool",
      "name": "Alinhar efeitos pelos portais",
      "default": true
    },
    "chunk-size": {
      "type": "int",
      "name": "Objetos por parte",
      "default": 200,
      "min": 20,
      "max": 2000
    },
    "max-objects": {
      "type": "int",
      "name": "Maximo de objetos colados",
      "default": 40000,
      "min": 100,
      "max": 500000
    }
  }
}
