
{
  "geode": "5.11.2",
  "gd": {
    "win": "2.2081",
    "android": "2.2081",
    "mac": "2.2081",
    "ios": "2.2081"
  },
  "version": "v2.0.0",
  "id": "arroisdocebr.decorcopy",
  "name": "Decor Copy V2",
  "developer": "ArroisDoceBr",
  "description": "Transfere decoracoes de fases de referencia para objetos equivalentes.",
  "settings": {
    "level-id": {
      "type": "int",
      "name": "ID da fase (alternativo)",
      "default": 0,
      "min": 0
    },
    "theme-only": {
      "type": "bool",
      "name": "Somente tema (sem decoracoes)",
      "default": false
    },
    "copy-colors": {
      "type": "bool",
      "name": "Copiar cores",
      "default": true
    },
    "copy-bg": {
      "type": "bool",
      "name": "Copiar fundo e chao",
      "default": true
    },
    "pattern-spikes": {
      "type": "bool",
      "name": "Copiar decoracoes de espinhos e serras",
      "default": true
    },
    "pattern-blocks": {
      "type": "bool",
      "name": "Copiar decoracoes de blocos",
      "default": true
    },
    "radius": {
      "type": "int",
      "name": "Raio de busca",
      "description": "Distancia maxima entre objeto e decoracao.",
      "default": 120,
      "min": 15,
      "max": 300
    },
    "max-per-object": {
      "type": "int",
      "name": "Maximo de decoracoes por objeto",
      "default": 300,
      "min": 1,
      "max": 1000
    },
    "overlay-zorder": {
      "type": "int",
      "name": "Camada visual",
      "description": "Controla a camada dos objetos copiados.",
      "default": 10,
      "min": -50,
      "max": 50
    },
    "chunk-size": {
      "type": "int",
      "name": "Objetos por parte",
      "default": 200,
      "min": 20,
      "max": 2000
    },
    "max-objects": {
      "type": "int",
      "name": "Limite de objetos copiados",
      "default": 40000,
      "min": 100,
      "max": 500000
    }
  }
}
