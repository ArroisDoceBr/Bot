{
  "geode": "5.11.2",
  "gd": {
    "win": "2.2081",
    "android": "2.2081",
    "mac": "2.2081",
    "ios": "2.2081"
  },
  "version": "v1.2.0",
  "id": "arroisdocebr.decorcopy",
  "name": "Decor Copy",
  "developer": "ArroisDoceBr",
  "description": "Aprende o estilo de outra fase e aplica nos espinhos da sua.",
  "settings": {
    "level-id": {
      "type": "int",
      "name": "ID da fase (plano B)",
      "default": 0,
      "min": 0
    },
    "radius": {
      "type": "int",
      "name": "Raio da decoracao",
      "description": "Distancia em unidades do espinho. 30 = 1 bloco.",
      "default": 45,
      "min": 15,
      "max": 150
    },
    "max-per-spike": {
      "type": "int",
      "name": "Max. objetos por espinho",
      "default": 50,
      "min": 3,
      "max": 300
    },
    "templates": {
      "type": "int",
      "name": "Variacoes de estilo",
      "description": "Quantos modelos de espinho da fase original usar.",
      "default": 4,
      "min": 1,
      "max": 10
    },
    "chunk-size": {
      "type": "int",
      "name": "Objetos por parte",
      "default": 200,
      "min": 20,
      "max": 2000
    },
    "max-objects": {
      "type": "int",
      "name": "Maximo de objetos",
      "default": 40000,
      "min": 100,
      "max": 500000
    },
    "copy-triggers": {
      "type": "bool",
      "name": "Copiar efeitos (pulse, shake, cor)",
      "default": true
    },
    "copy-colors": {
      "type": "bool",
      "name": "Copiar cores do tema",
      "default": true
    },
    "copy-bg": {
      "type": "bool",
      "name": "Copiar fundo e chao",
      "default": true
    }
  }
}
