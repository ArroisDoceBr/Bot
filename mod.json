{
  "geode": "5.11.2",
  "gd": {
    "win": "2.2081",
    "android": "2.2081",
    "mac": "2.2081",
    "ios": "2.2081"
  },
  "version": "v1.3.0",
  "id": "arroisdocebr.decorcopy",
  "name": "Decor Copy",
  "developer": "ArroisDoceBr",
  "description": "Copia o tema de outra fase e sincroniza os efeitos com a sua.",
  "settings": {
    "level-id": {
      "type": "int",
      "name": "ID da fase (plano B)",
      "default": 0,
      "min": 0
    },
    "copy-colors": {
      "type": "bool",
      "name": "Copiar cores do tema",
      "default": true
    },
    "copy-bg": {
      "type": "bool",
      "name": "Copiar fundo e chao",
      "default": true
    },
    "copy-spike-skin": {
      "type": "bool",
      "name": "Visual dos espinhos e serras",
      "default": true
    },
    "overlay-zorder": {
      "type": "int",
      "name": "Z-order do visual dos espinhos",
      "description": "Maior = fica por cima do seu espinho.",
      "default": 10,
      "min": -50,
      "max": 50
    },
    "copy-effects": {
      "type": "bool",
      "name": "Copiar efeitos (cor, pulse, fundo)",
      "default": true
    },
    "copy-shake": {
      "type": "bool",
      "name": "Copiar shake",
      "default": false
    },
    "align-portals": {
      "type": "bool",
      "name": "Alinhar efeitos pelos portais",
      "default": true
    },
    "delete-my-color-triggers": {
      "type": "bool",
      "name": "Apagar MEUS triggers de cor",
      "default": true
    },
    "chunk-size": {
      "type": "int",
      "name": "Objetos por parte",
      "default": 200,
      "min": 20,
      "max": 2000
    },
    "max-objects": {
      "type": "int",
      "name": "Maximo de objetos",
      "default": 40000,
      "min": 100,
      "max": 500000
    }
  }
}
