{
  "geode": "5.11.2",
  "gd": {
    "win": "2.2081",
    "android": "2.2081",
    "mac": "2.2081",
    "ios": "2.2081"
  },
  "version": "v1.1.0",
  "id": "arroisdocebr.decorcopy",
  "name": "Decor Copy",
  "developer": "ArroisDoceBr",
  "description": "Copia decoracao, efeitos, cores e fundo de outra fase no editor.",
  "settings": {
    "level-id": {
      "type": "int",
      "name": "ID da fase (plano B)",
      "description": "Usado se a caixa de texto do popup ficar vazia.",
      "default": 0,
      "min": 0
    },
    "group-base": {
      "type": "int",
      "name": "Grupo inicial",
      "default": 4000,
      "min": 1,
      "max": 9000
    },
    "chunk-size": {
      "type": "int",
      "name": "Objetos por parte",
      "description": "Menor = mais lento, mas trava menos.",
      "default": 200,
      "min": 20,
      "max": 2000
    },
    "max-objects": {
      "type": "int",
      "name": "Maximo de objetos",
      "default": 60000,
      "min": 100,
      "max": 500000
    },
    "copy-triggers": {
      "type": "bool",
      "name": "Copiar triggers de efeito",
      "default": true
    },
    "copy-colors": {
      "type": "bool",
      "name": "Copiar cores do tema",
      "default": true
    },
    "copy-bg": {
      "type": "bool",
      "name": "Copiar fundo e chao",
      "default": true
    }
  }
}
